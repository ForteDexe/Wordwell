{
  "manifest_version": 3,
  "name": "Wordwell",
  "version": "0.5.6",
  "description": "Write clearly. Translate locally. Grammar correction and translation with a model running on your computer.",
  "minimum_chrome_version": "137",
  "permissions": ["contextMenus", "storage", "clipboardWrite", "unlimitedStorage"],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Open Wordwell",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["inline.js"],
    "run_at": "document_idle",
    "all_frames": true
  }],
  "cross_origin_embedder_policy": { "value": "require-corp" },
  "cross_origin_opener_policy": { "value": "same-origin" },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; connect-src 'self'; style-src 'self'; img-src 'self' data:; object-src 'none';"
  }
}
