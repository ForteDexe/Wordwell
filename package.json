{
  "name": "wordwell",
  "version": "0.5.7",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test:engine": "node scripts/test-engine.mjs",
    "test:edit": "node --test scripts/edit-model.test.mjs",
    "test:spelling": "npm run build:extension && node --test scripts/spelling.test.mjs && node scripts/test-spelling-browser.mjs",
    "test:edit-browser": "node scripts/test-edit-model.mjs",
    "check:public": "node scripts/check-public-boundary.mjs",
    "setup:hooks": "git config core.hooksPath .githooks",
    "build:extension": "node scripts/build-extension.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "build:release": "node scripts/build-release.mjs",
    "test:release": "npm run build:release && node scripts/test-release.mjs",
    "test:package": "npm run build:extension && node --test scripts/release-package.test.mjs scripts/spelling.test.mjs",
    "test:diff": "node --test scripts/text-diff.test.mjs",
    "test:budget": "node --test scripts/token-budget.test.mjs",
    "test:workspace": "node scripts/test-workspace.mjs",
    "test:server": "npm run build:extension && node scripts/test-server-mode.mjs",
    "test:selection-drag": "node scripts/test-selection-drag.mjs --standalone",
    "test:install": "node scripts/test-install.mjs",
    "test:extension": "node scripts/test-extension.mjs",
    "test:editors": "node scripts/test-editor-checks.mjs",
    "benchmark:extension": "node scripts/benchmark-extension.mjs"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "@wllama/wllama": "3.8.1",
    "dictionary-en": "4.0.0",
    "dictionary-en-gb": "3.0.0",
    "nspell": "2.1.5",
    "onnxruntime-web": "1.31.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "playwright": "1.64.1"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "Apache-2.0"
}
